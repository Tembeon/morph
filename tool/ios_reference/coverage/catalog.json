{
  "schema": 1,
  "scope": "Complete Liquid Glass UI kit ambition; draft inventory is a lower bound, not an exhaustive UIKit claim. Platform-service controllers need explicit adapters.",
  "requirements": [
    {
      "id": "api",
      "dimension": "api",
      "question": "Have all public variants, properties, methods, defaults, availability and callback semantics been inventoried?",
      "oracle": "api-review"
    },
    {
      "id": "layout",
      "dimension": "geometry",
      "question": "What are intrinsic size, compression, overflow, alignment and safe-area rules?",
      "oracle": "geometry-contract"
    },
    {
      "id": "states",
      "dimension": "state",
      "question": "Which states are reachable and what is visible and enabled in each?",
      "oracle": "state-contract"
    },
    {
      "id": "transitions",
      "dimension": "transition",
      "question": "How do every transition, return path and interrupted transition behave?",
      "oracle": "transition-contract"
    },
    {
      "id": "boundaries",
      "dimension": "boundary",
      "question": "What happens below, at and above every numeric, content and timing boundary?",
      "oracle": "boundary-contract"
    },
    {
      "id": "configuration",
      "dimension": "configuration",
      "question": "Which configuration combinations change behavior, and which are incompatible?",
      "oracle": "configuration-contract"
    },
    {
      "id": "events",
      "dimension": "events",
      "question": "Which callbacks fire, in what order, with what values and how many times?",
      "oracle": "event-contract"
    },
    {
      "id": "input",
      "dimension": "input",
      "question": "How do drag out/back, second pointers, cancellation and gesture competition behave?",
      "oracle": "input-contract"
    },
    {
      "id": "mutation",
      "dimension": "lifecycle",
      "question": "What happens when content, value, enabled state or layout changes during interaction?",
      "oracle": "lifecycle-contract"
    },
    {
      "id": "accessibility",
      "dimension": "accessibility",
      "question": "Are semantics, focus, large text, VoiceOver and reduced effects correct?",
      "oracle": "accessibility-contract"
    },
    {
      "id": "optics",
      "dimension": "optics",
      "question": "How do geometry, material, color space, backdrop and motion affect pixels?",
      "oracle": "optical-contract"
    },
    {
      "id": "platform",
      "dimension": "platform",
      "question": "Are phone/tablet, resizing, RTL, locales, keyboard and Flutter platform fallbacks covered?",
      "oracle": "platform-contract"
    },
    {
      "id": "performance",
      "dimension": "performance",
      "question": "Are frame time, memory, sampling cost and energy acceptable under stress?",
      "oracle": "performance-contract"
    }
  ],
  "profiles": [
    {
      "id": "ios27-simulator-light",
      "environment": {
        "nativeOSMajor": 27,
        "nativeTarget": "simulator",
        "appearance": "light"
      },
      "readBack": {
        "rm": false,
        "rt": false
      }
    },
    {
      "id": "ios27-simulator-dark",
      "environment": {
        "nativeOSMajor": 27,
        "nativeTarget": "simulator",
