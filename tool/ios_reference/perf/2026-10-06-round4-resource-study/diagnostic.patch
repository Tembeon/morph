+import 'package:flutter/foundation.dart';
+import 'package:flutter/rendering.dart';
+
+/// Temporary resource counters; absent from production measurements.
+class MorphResourceStudy {
+  /// Whether the diagnostic APK collects resource counters.
+  static const enabled = bool.fromEnvironment('MORPH_RESOURCE_STUDY');
+
+  /// Human-readable role for a renderer's layer.
+  static String Function(RenderBox)? label;
+
+  static final _owners = Expando<RenderBox>();
+  static final _previous = Expando<_Inputs>();
+  static final _labels = Expando<String>();
+  static final _layers = <RenderBox, _Counts>{};
+  static final _global = <String, int>{};
+  static bool _collecting = false;
+
+  /// Links a native renderer to its layer.
+  static void owner(Object renderer, RenderBox owner) {
+    _owners[renderer] = owner;
+  }
+
+  /// Starts an ordinary audit run's counter window.
+  static void begin() {
+    _layers.clear();
+    _global.clear();
+    _collecting = true;
+  }
+
+  /// Stops collecting and copies the run's counters.
+  static Map<String, Object?> end() {
+    _collecting = false;
+    return {
+      'global': Map<String, int>.of(_global),
+      'layers': [
+        for (final entry in _layers.entries)
+          {
+            'id': identityHashCode(entry.key),
+            'role': _labels[entry.key] ?? entry.key.runtimeType.toString(),
+            'counts': Map<String, int>.of(entry.value.counts),
+            'peaks': Map<String, int>.of(entry.value.peaks),
+          },
+      ],
+    };
+  }
+
+  static _Counts? _of(RenderBox owner) {
+    if (!_collecting) return null;
+    _labels[owner] ??= label?.call(owner) ?? owner.runtimeType.toString();
+    return _layers[owner] ??= _Counts();
+  }
+
+  /// Counts a layer path taken during the window.
+  static void count(RenderBox owner, String name) {
+    final stats = _of(owner);
+    if (stats == null) return;
+    stats.counts[name] = (stats.counts[name] ?? 0) + 1;
+  }
+
+  /// Records output coverage, not an estimate of engine capture traffic.
+  static void filterBounds(
+    RenderBox owner,
+    Rect rect,
+    double dpr,
+    double sigma,
+  ) {
+    final stats = _of(owner);
+    if (stats == null) return;
+    final values = {
+      'filter_width_px': (rect.width * dpr).ceil(),
+      'filter_height_px': (rect.height * dpr).ceil(),
+      'filter_output_pixels':
+          (rect.width * dpr).ceil() * (rect.height * dpr).ceil(),
+      'blur_sigma_milli_px': (sigma * dpr * 1000).round(),
+    };
+    for (final entry in values.entries) {
+      if (entry.value > (stats.peaks[entry.key] ?? 0)) {
+        stats.peaks[entry.key] = entry.value;
+      }
+    }
+  }
+
+  /// Compares the actual packed analytic inputs, never only cache revisions.
+  static void native(
+    Object renderer,
+    ByteData uniforms, {
+    required bool field,
+    required bool materials,
+    required bool tintOnly,
+    required int ringBytes,
+    required int uniformArenaBytes,
+    required int mattePixels,
+  }) {
+    final data = uniforms.buffer.asUint8List(
+      uniforms.offsetInBytes,
+      uniforms.lengthInBytes,
+    );
+    final before = _previous[renderer];
+    final same =
+        !field &&
+        before != null &&
+        !before.field &&
+        before.materials == materials &&
+        before.tintOnly == tintOnly &&
+        listEquals(data, before.bytes);
+    if (!same) {
+      _previous[renderer] = _Inputs(
+        Uint8List.fromList(data),
+        field: field,
+        materials: materials,
+        tintOnly: tintOnly,
+      );
+    }
+    final owner = _owners[renderer];
+    if (owner == null) return;
+    final stats = _of(owner);
+    if (stats == null) return;
+    count(owner, 'native.encode');
+    if (field) count(owner, 'native.field');
+    if (materials) count(owner, 'native.material_pass');
+    if (same) count(owner, 'native.identical_analytic_inputs');
+    for (final entry in {
+      'ring_bytes': ringBytes,
+      'matte_pixels': mattePixels,
+    }.entries) {
+      final old = stats.peaks[entry.key] ?? 0;
+      if (entry.value > old) stats.peaks[entry.key] = entry.value;
+    }
+    if (uniformArenaBytes > (_global['uniform_arena_bytes'] ?? 0)) {
+      _global['uniform_arena_bytes'] = uniformArenaBytes;
+    }
+  }
+}
+
+class _Inputs {
+  _Inputs(
+    this.bytes, {
+    required this.field,
+    required this.materials,
+    required this.tintOnly,
+  });
+  final Uint8List bytes;
+  final bool field;
+  final bool materials;
+  final bool tintOnly;
+}
+
+class _Counts {
+  final counts = <String, int>{};
+  final peaks = <String, int>{};
+}
