index 0000000..94f60cc
--- /dev/null
+++ b/lib/src/glass/renderer/internal/released_texture_pool.dart
@@ -0,0 +1,67 @@
+import 'package:meta/meta.dart';
+
+/// FIFO reuse storage bounded by both entry count and texture capacity.
+@internal
+final class MorphReleasedTexturePool<T extends Object> {
+  /// Creates storage whose drops notify [onDrop] without disposing handles.
+  MorphReleasedTexturePool({
+    required this.maxEntries,
+    required this.maxBytes,
+    required this.bytesOf,
+    required this.onDrop,
+  }) : assert(maxEntries >= 0),
+       assert(maxBytes >= 0);
+
+  /// Maximum retained entry count.
+  final int maxEntries;
+
+  /// Maximum retained capacity, excluding driver overhead.
+  final int maxBytes;
+
+  /// Stable capacity of an entry in bytes.
+  final int Function(T) bytesOf;
+
+  /// Notification when storage drops its reference to an entry.
+  final void Function(T) onDrop;
+
+  final List<T> _entries = [];
+  int _bytes = 0;
+
+  /// Number of retained entries.
+  int get length => _entries.length;
+
+  /// Total retained capacity in bytes.
+  int get bytes => _bytes;
+
+  /// Entry at [index], in insertion order.
+  T operator [](int index) => _entries[index];
+
+  /// Retains [entry], evicting oldest entries when either budget is exceeded.
+  void add(T entry) {
+    final size = bytesOf(entry);
+    if (size < 0) throw ArgumentError.value(size, 'bytesOf');
+    if (size > maxBytes || maxEntries == 0) {
+      onDrop(entry);
+      return;
+    }
+    _entries.add(entry);
+    _bytes += size;
+    while (length > maxEntries || _bytes > maxBytes) {
+      onDrop(removeAt(0));
+    }
+  }
+
+  /// Claims an entry and removes its capacity from this pool.
+  T removeAt(int index) {
+    final entry = _entries.removeAt(index);
+    _bytes -= bytesOf(entry);
+    return entry;
+  }
+
+  /// Drops entries for which [test] is true.
+  void removeWhere(bool Function(T) test) {
+    for (var index = length - 1; index >= 0; index--) {
+      if (test(_entries[index])) onDrop(removeAt(index));
+    }
+  }
+}
diff --git a/test/glass_released_texture_pool_test.dart b/test/glass_released_texture_pool_test.dart
