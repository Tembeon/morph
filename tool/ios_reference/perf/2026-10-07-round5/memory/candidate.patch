@@ -0,0 +1,59 @@
+// ignore_for_file: invalid_use_of_internal_member
+
+import 'package:flutter_test/flutter_test.dart';
+import 'package:morph/src/glass/renderer/internal/released_texture_pool.dart';
+
+final class _Texture {
+  const _Texture(this.bytes);
+
+  final int bytes;
+}
+
+void main() {
+  test('capacity evicts the oldest entry before the count limit', () {
+    final dropped = <_Texture>[];
+    final pool = MorphReleasedTexturePool<_Texture>(
+      maxEntries: 4,
+      maxBytes: 100,
+      bytesOf: (texture) => texture.bytes,
+      onDrop: dropped.add,
+    );
+    const first = _Texture(60);
+    const second = _Texture(50);
+    pool.add(first);
+    pool.add(second);
+    expect(pool.length, 1);
+    expect(pool.bytes, 50);
+    expect(pool[0], same(second));
+    expect(dropped, [first]);
+    pool.add(const _Texture(101));
+    expect(pool[0], same(second));
+    expect(pool.bytes, 50);
+    expect(dropped.length, 2);
+    expect(pool.removeAt(0), same(second));
+    expect(pool.bytes, 0);
+    expect(dropped.length, 2);
+  });
+
+  test('count eviction and age removal preserve exact accounting', () {
+    final dropped = <_Texture>[];
+    final pool = MorphReleasedTexturePool<_Texture>(
+      maxEntries: 2,
+      maxBytes: 100,
+      bytesOf: (texture) => texture.bytes,
+      onDrop: dropped.add,
+    );
+    for (final bytes in [10, 20, 30]) {
+      pool.add(_Texture(bytes));
+    }
+    expect(pool.bytes, 50);
+    expect(dropped.single.bytes, 10);
+    pool.removeWhere((texture) => texture.bytes == 20);
+    expect(pool.bytes, 30);
+    expect(pool.length, 1);
+    expect(dropped.map((texture) => texture.bytes), [10, 20]);
+    pool.removeWhere((texture) => true);
+    expect(pool.bytes, 0);
+    expect(pool.length, 0);
+  });
+}
