+#version 460 core
+#include <flutter/runtime_effect.glsl>
+
+// Experimental implementation of the 5/8-tap dual filter from
+// Marius Bjorge, Bandwidth-efficient graphics, SIGGRAPH 2015, slides 20-21.
+// https://community.arm.com/cfs-file/__key/communityserver-blogs-components-weblogfiles/00-00-00-20-66/siggraph2015_2D00_mmg_2D00_marius_2D00_notes.pdf
+uniform vec2 inputSize;
+uniform float offset;
+uniform float upsample;
+uniform float probe;
+uniform sampler2D source;
+out vec4 fragColor;
+
+void main() {
+  vec2 uv = FlutterFragCoord().xy / inputSize;
+#ifdef IMPELLER_TARGET_OPENGLES
+  uv.y = 1.0 - uv.y;
+#endif
+  if (probe > 0.5) {
+    fragColor = vec4(inputSize / vec2(1080.0, 2400.0), 0.0, 1.0);
+    return;
+  }
+  vec2 h = 0.5 * offset / inputSize;
+  vec4 c;
+  if (upsample < 0.5) {
+    c = 4.0 * texture(source, uv);
+    c += texture(source, uv + h);
+    c += texture(source, uv - h);
+    c += texture(source, uv + vec2(h.x, -h.y));
+    c += texture(source, uv + vec2(-h.x, h.y));
+    c *= 0.125;
+  } else {
+    c = texture(source, uv + vec2(2.0 * h.x, 0.0));
+    c += texture(source, uv + vec2(-2.0 * h.x, 0.0));
+    c += texture(source, uv + vec2(0.0, 2.0 * h.y));
+    c += texture(source, uv + vec2(0.0, -2.0 * h.y));
+    c += 2.0 * texture(source, uv + h);
+    c += 2.0 * texture(source, uv - h);
+    c += 2.0 * texture(source, uv + vec2(h.x, -h.y));
+    c += 2.0 * texture(source, uv + vec2(-h.x, h.y));
+    c /= 12.0;
+  }
+  fragColor = c;
+}
