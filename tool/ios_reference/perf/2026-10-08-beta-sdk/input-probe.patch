diff --git a/example/shaders/beta_gaussian.frag b/example/shaders/beta_gaussian.frag
new file mode 100644
index 0000000..de54523
--- /dev/null
+++ b/example/shaders/beta_gaussian.frag
@@ -0,0 +1,32 @@
+#include <flutter/runtime_effect.glsl>
+
+uniform vec2 u_size;
+uniform vec2 u_axis;
+uniform float u_count;
+uniform float u_center;
+uniform vec2 u_taps[96];
+uniform sampler2D u_input;
+out vec4 frag_color;
+
+void main() {
+  if (u_count < 0.0) {
+    vec2 bytes = mod(floor(FlutterFragCoord().x), 2.0) < 1.0
+        ? mod(u_size, 256.0) : floor(u_size / 256.0);
+    frag_color = vec4(bytes / 255.0, 0.0, 1.0);
+    return;
+  }
+  vec2 uv = FlutterFragCoord().xy / u_size;
+#ifdef IMPELLER_TARGET_OPENGLES
+  uv.y = 1.0 - uv.y;
+#endif
+  vec2 step_uv = u_axis / u_size;
+  vec4 sum = texture(u_input, uv) * u_center;
+  for (int i = 0; i < 96; i++) {
+    if (float(i) >= u_count) break;
+    vec2 tap = u_taps[i];
+    vec2 delta = step_uv * tap.x;
+    sum += (texture(u_input, uv + delta) +
+            texture(u_input, uv - delta)) * tap.y;
+  }
+  frag_color = sum;
+}
