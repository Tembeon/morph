# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.buildlog/
.history
.svn/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
# Libraries should not include pubspec.lock, per https://dart.dev/guides/libraries/private-files#pubspeclock.
/pubspec.lock
**/doc/api/
.dart_tool/
.flutter-plugins-dependencies
/build/
/coverage/
CLAUDE.local.md

# Working material of morph's own development: measurement evidence, audit
# and research reports, native reference captures and design notes. It
# stays in the owner's checkout and in the history; the library, its tests,
# the tools they run and the contributor docs do not read it.
/tool/audit/*
!/tool/audit/shader/
/tool/ios_reference/perf/20*/
/tool/ios_reference/references/
/docs/architecture/
/docs/research/
/docs/standalone-library-plan.md
